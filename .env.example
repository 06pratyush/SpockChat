# ─────────────────────────────────────────────────────────────────────────────
# SpockChat configuration
#
# Every value below is optional — SpockChat starts with sane defaults if this
# file is missing entirely. Anything you do set is validated at boot: a bad
# value stops the server with an explanation instead of failing mysteriously
# later. See server/config/index.js for the authoritative list.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3000
# HOST=0.0.0.0
# NODE_ENV=development

# REQUIRED for sessions to survive a restart. If this is unset or left at the
# placeholder, SpockChat generates a random secret per process and warns — which
# means everyone is logged out every time you restart the server.
JWT_SECRET=replace-this-with-a-long-random-string

# ── Storage ──────────────────────────────────────────────────────────────────
# DB_PATH=./spockchat.db
# DB_BUSY_TIMEOUT_MS=5000          # wait rather than error under write contention
# DB_CHECKPOINT_INTERVAL_MS=60000  # keeps the WAL file from growing forever

# ── Chat limits ──────────────────────────────────────────────────────────────
# MAX_GROUP_MEMBERS=5
# MAX_MESSAGE_LENGTH=8000          # hard cap; oversized sends are rejected with a hint
# HISTORY_PAGE_SIZE=100
# AI_CONTEXT_MESSAGES=40           # how much conversation the model sees

# ── Ollama ───────────────────────────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3
# AI_TIMEOUT_MS=120000             # ceiling for one generation
# AI_MAX_CONCURRENT=1              # a local GPU cannot usefully run more than one
# AI_MAX_QUEUE=8                   # past this, requests fail fast with "AI is busy"
# AI_RETRIES=1
# AI_BREAKER_FAILURES=4            # consecutive failures before the circuit opens
# AI_BREAKER_RESET_MS=20000        # how long it stays open before probing again

# ── Federation (peer-to-peer) ────────────────────────────────────────────────
# FEDERATION_TIMEOUT_MS=8000
# FEDERATION_RETRIES=2
# FEDERATION_BREAKER_FAILURES=5
# FEDERATION_BREAKER_RESET_MS=30000
# FEDERATION_OUTBOX_INTERVAL_MS=15000    # background retry cadence for queued peer calls
# FEDERATION_OUTBOX_MAX_ATTEMPTS=12
# FEDERATION_ALLOW_PRIVATE_HOSTS=true    # set false to block LAN/loopback targets (SSRF hardening)

# ── Realtime ─────────────────────────────────────────────────────────────────
# SOCKET_PING_INTERVAL_MS=20000    # heartbeat — detects half-open connections
# SOCKET_PING_TIMEOUT_MS=25000
# SOCKET_RECOVERY_MS=120000        # replay window for brief disconnections
# SOCKET_MAX_BUFFER=524288

# ── Rate limits ──────────────────────────────────────────────────────────────
# RATE_AUTH_PER_MIN=10             # per IP — blunts credential stuffing
# RATE_API_PER_MIN=600             # per IP
# RATE_FEDERATION_PER_MIN=30       # per IP, on the unauthenticated peer endpoints
# RATE_MESSAGES_PER_MIN=120        # per user, over the socket
# RATE_AI_PER_MIN=12               # per user

# ── Tunnel ───────────────────────────────────────────────────────────────────
# TUNNEL_HOST=localhost.run
# TUNNEL_USER=nokey
# TUNNEL_START_TIMEOUT_MS=30000
# TUNNEL_AUTO_RESTART=true         # reconnect automatically if the tunnel drops
# TUNNEL_MAX_RESTARTS=5

# ── Behind a reverse proxy ───────────────────────────────────────────────────
# TRUST_PROXY=true                 # honour X-Forwarded-For / -Host (only behind a proxy you control)
# PUBLIC_URL=https://chat.example.com   # the address peers should use to reach you
# CORS_ORIGIN=*

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=info                   # silent | error | warn | info | debug
# LOG_JSON=false                   # structured output for log shipping
